# pub uses this file (in preference to .gitignore) to decide what to publish.
# Keep build artifacts, tool caches, and OS cruft out of the published archive.
.DS_Store
**/.DS_Store
.dart_tool/
build/
**/build/
ios/apple_spatial_capture/.build

# Full-res source images used nowhere in README or pubspec screenshots
# (~21 MB). The README shows the smaller *-readme.png thumbnails instead.
screenshots/object-capture/results/object-capture-result.png
screenshots/object-capture/results/object-capture-result-2.png
